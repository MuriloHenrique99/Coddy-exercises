#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {

    int n;
    cin >> n;
    
    vector<string> cities;

    for (int i = 0; i < n; i++) {
        string city;
        cin >> city;
        cities.push_back(city);
    }

    for(const std::string& cidades : cities){
        std::cout << "City: " << cidades << " (Length: " << cidades.length() << ")" << std::endl;
    }
    std::cout<< "Total cities processed: " << cities.size() << std::endl;
    
    return 0;
}
