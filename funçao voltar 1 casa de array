#include <string>
#include <iostream>

using namespace std;
string decodeMessage(string encodedMessage) {
        // Escreva o código aqui
        std::string letras = {'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 
        't', 'u', 'v', 'w', 'x', 'y', 'z'};
        size_t tam = std::size(encodedMessage);
        for(int i = 0; i < tam; i++){
            int j = 0;
            if(encodedMessage[i] == ' '){
                continue;
            } else {
                while(encodedMessage[i] != letras[j]){
                    j++;
                    if(encodedMessage[i] == letras[j]){
                        encodedMessage[i] = letras[j - 1];
                        break;
                    }
                }
                if(encodedMessage[i] == letras[j]){
                    encodedMessage[i] = letras[25];
                }
            }
        }

    return encodedMessage;
}
